# Copia a keystore.properties (gitignored) y ajusta rutas/secretos.
# Generar keystore (ejemplo):
#   keytool -genkeypair -v -keystore .tauri/merz-games-android.jks \
#     -alias merz-games -keyalg RSA -keysize 2048 -validity 10000
#
# Preferir ruta absoluta (Windows: E:/.../.tauri/merz-games-android.jks).
# Si es relativa, se resuelve desde src-tauri/gen/android/.

password=CHANGE_ME
keyAlias=merz-games
storeFile=E:/Ula/merz-games/.tauri/merz-games-android.jks
