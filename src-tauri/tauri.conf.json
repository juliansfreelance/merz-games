{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Merz Games",
  "version": "0.1.0",
  "identifier": "com.merzgames.app",
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Merz Games",
        "width": 1080,
        "height": 1920,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/merz-games/browser"
  },
  "plugins": {
    "updater": {
      "pubkey": "dGF1cmktdXBkYXRlci1wbGFjZWhvbGRlci1rZXktd2l0aC02NC1ieXRlcy1vZi1kYXRhCg==",
      "endpoints": [
        "https://raw.githubusercontent.com/juliansfreelance/merz-games/main/releases/updater.json"
      ]
    }
  }
}
