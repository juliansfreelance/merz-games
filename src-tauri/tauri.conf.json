{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Merz Games",
  "version": "0.1.2",
  "identifier": "com.merzgames.app",
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Merz Games",
        "width": 1080,
        "height": 1920,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/content/**"]
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run copy:videos && npm run build",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/merz-games/browser"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2OTdBQjJCQTUyNEQ0NEIKUldSTDFDU2xLNnVYWnZIbG1adVd4a1BzSmNMNFo5emo5L3FGSGJINE9PWTRIM3dLYS9YVnNTd3IK",
      "endpoints": [
        "https://github.com/juliansfreelance/merz-games/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
